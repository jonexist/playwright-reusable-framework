# Copy to `.env` for local runs. Never commit `.env`.

# --- Targets -----------------------------------------------------------
# The bundled demo app (`npm run demo:start`) listens here. Point these at your
# own app/API when you adopt the framework.
BASE_URL=http://localhost:4173
API_BASE_URL=http://localhost:4173

# Playwright starts the bundled demo app (node demo-app/server.js) by default.
# Set to false when BASE_URL points at your own app.
# START_DEMO_APP=true

# --- Primary test user (global-setup logs in once and saves storage state) --
# Demo values only. For a real app use a dedicated, seeded E2E account.
TEST_USER_EMAIL=admin@example.com
TEST_USER_PASSWORD=demo-admin-password

# --- Restricted (RBAC) user — optional ---------------------------------
TEST_RESTRICTED_USER_EMAIL=viewer@example.com
TEST_RESTRICTED_USER_PASSWORD=demo-viewer-password

# --- App paths ----------------------------------------------------------
LOGIN_PATH=/login
# Where a successful login lands (regex-safe path).
POST_LOGIN_PATH=/dashboard
# Optional: change-password style interstitial that is also an acceptable landing.
CHANGE_PASSWORD_PATH=/change-password

# --- Run controls (all optional) ----------------------------------------
# TEST_WORKERS=2
# PLAYWRIGHT_GLOBAL_TIMEOUT_MS=3000000
# PLAYWRIGHT_MAX_FAILURES=5
# CI=true
